# Paths: use ABSOLUTE paths. dbt runs from dbt_multidim/ while the Python scripts run from the
# repository root, so a relative path resolves to two different files. `make` converts relative
# paths to absolute automatically; a plain `dbt ...` command does not.
DATA_ROOT=/absolute/path/to/retail_multidim_pipeline/data
DUCKDB_PATH=/absolute/path/to/retail_multidim_pipeline/data/lakehouse.duckdb
# DuckDB limits: about 60-70 % of RAM. Laptop 16 GB -> 10GB / 6 threads; server 125 GB (about 100 GB free) -> 80GB / 16 threads.
# Keep comments on their own line: `make` would otherwise export the value with trailing spaces.
DUCKDB_MEMORY=10GB
DUCKDB_THREADS=6
# ALL (server), or one country code while developing on the laptop (VN is the smallest country with complete data);
# applies to make bronze: tables with a country_col in ingestion/table_contracts.yml, tender lines of the loaded sales, dimensions whole
COUNTRY_FILTER=ALL
# evaluation scope decided 2026-10-28 (issue #54): the three countries covered by the Parquet re-export; used by the holiday builder
COUNTRIES=SG,TH,VN
# one anchor every 4 weeks per member for training (test always uses stride = 1)
TRAIN_ANCHOR_STRIDE=4
N_CANDIDATES=200
# anchor selection (evaluation/build_anchor_grid.py, issue #29): only anchors with a purchase within this many days are used
# (0 = keep all); caps are per country and split, taken by hash rank; pair table ≈ N_CANDIDATES × used anchors
ANCHOR_LABEL_HORIZON=90
TRAIN_ANCHOR_CAP=50000
VALID_ANCHOR_CAP=15000
TEST_ANCHOR_CAP=50000
KAFKA_BOOTSTRAP=localhost:19092

# Organisation-specific tokens to mask in the generated reports (comma-separated, case-insensitive).
# Keep the actual list in your local .env only; the reports must not name the data owner.
REDACT_TERMS=
