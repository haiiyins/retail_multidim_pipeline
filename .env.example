DATA_ROOT=./data
DUCKDB_PATH=./data/lakehouse.duckdb
DUCKDB_MEMORY=10GB            # server: 200GB
DUCKDB_THREADS=6              # server: 32
COUNTRY_FILTER=ALL            # or a single country code while developing
COUNTRIES=XX,XX,XX,XX,XX      # the 5 country codes found in step 2 (used by the holiday builder)
TRAIN_ANCHOR_STRIDE=4         # one anchor every 4 weeks per member for training (test always uses stride = 1)
N_CANDIDATES=200
KAFKA_BOOTSTRAP=localhost:19092
